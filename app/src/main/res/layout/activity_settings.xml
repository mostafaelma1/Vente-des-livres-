<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Paramètres"
        app:titleTextColor="@color/on_primary"
        app:navigationIconTint="@color/on_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView style="@style/CardSection">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/SectionTitle" android:text="Serveur d'analyse (backend)" />

                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="URL du backend qui effectue l'extraction automatique depuis marchespublics.gov.ma."
                        android:textColor="@color/text_secondary" android:textSize="12sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:hint="URL du serveur (http:// ou https://)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBackendUrl" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Avertissement émulateur vs téléphone réel -->
                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/warning_tint"
                        android:padding="12dp"
                        android:text="⚠️ 10.0.2.2 fonctionne uniquement sur émulateur Android. Sur téléphone réel, utilisez l'adresse IP locale du PC ou une URL backend en ligne."
                        android:textColor="@color/warning" android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Exemples :\n• Téléphone réel (même Wi-Fi que le PC) : http://192.168.1.x:8000\n• Émulateur Android : http://10.0.2.2:8000\n• Serveur en ligne (production) : https://monserveur.com"
                        android:textColor="@color/text_secondary" android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTest"
                        style="@style/OutlineButton"
                        android:layout_marginTop="16dp"
                        android:text="Tester la connexion serveur" />

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ProgressBar
                            android:id="@+id/progress"
                            android:layout_width="20dp" android:layout_height="20dp"
                            android:layout_marginEnd="10dp" android:visibility="gone" />
                        <TextView
                            android:id="@+id/tvTestStatus"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSave" style="@style/PrimaryButton"
                        android:layout_marginTop="14dp" android:text="Enregistrer" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmulator"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="center" android:layout_marginTop="6dp"
                        android:text="Remplir l'adresse émulateur (10.0.2.2)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Le mode manuel fonctionne sans serveur ni connexion. Le serveur n'est nécessaire que pour l'analyse automatique par URL : tant qu'aucune URL valide n'est configurée, l'analyse automatique reste désactivée."
                android:textColor="@color/text_secondary" android:textSize="12sp"
                android:textStyle="italic" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
