<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_toolbar_gradient"
        app:navigationIconTint="@color/on_primary"
        app:titleTextColor="@color/on_primary" />

    <!-- Month navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prevMonth"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/prev_month"
            android:textColor="@color/primary"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/periodLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Juin 2026" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextMonth"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/next_month"
            android:textColor="@color/primary"
            android:textSize="22sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Type filter: separate Virement / Mise à disposition -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/typeFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/typeAll"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/filter_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/typeVir"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/filter_virement" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/typeMise"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/filter_mise" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Site (lieu de travail) filter -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/siteBtn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="start|center_vertical"
                android:textColor="@color/primary"
                app:icon="@drawable/ic_clients"
                app:iconGravity="textStart"
                app:iconTint="@color/primary"
                app:strokeColor="@color/stroke" />

            <!-- Account card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardSection">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/virement_account"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/accountLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Compte principal" />

                    <TextView
                        android:id="@+id/accountRib"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="225 010 030 705 289 651 011 902" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_gradient"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingVertical="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/countLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="0"
                        android:textColor="@color/on_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/summary_employees"
                        android:textColor="@color/on_primary_dim"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="4dp"
                    android:background="#44FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/totalLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="0 DH"
                        android:textColor="@color/on_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payroll_total"
                        android:textColor="@color/on_primary_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Amount in words -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardSection"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/virement_amount_words"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/amountWords"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        tools:text="Quatre mille huit cents dirhams" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Export buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pdfBtn"
                    style="@style/PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:icon="@drawable/ic_receipt"
                    app:iconGravity="textStart"
                    app:iconTint="@color/on_primary"
                    android:text="@string/virement_pdf" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/excelBtn"
                    style="@style/OutlineButton"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconTint="@color/primary"
                    android:text="@string/virement_excel" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Partage · مشاركة : WhatsApp · E-mail · Drive"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
