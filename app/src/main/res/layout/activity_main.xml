<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- En-tête arrondi avec dégradé orange -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_header_curved"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="44dp"
            android:paddingBottom="28dp">

            <ImageView
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo_bmarche" />

            <View
                android:layout_width="56dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@color/brand_orange" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Bannière Premium (mise en avant abonnement) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnPremium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_premium_gradient"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_star"
                        android:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_premium_title"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.95"
                            android:text="@string/home_premium_sub"
                            android:textColor="@color/white"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_white"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="Bientôt"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:layout_marginStart="6dp"
                android:text="Que voulez-vous faire ?"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Nouvelle analyse -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnUrl"
                style="@style/HomeCard">
                <LinearLayout style="@style/HomeCardRow">
                    <FrameLayout style="@style/HomeIconWrap"
                        android:backgroundTint="@color/brand_orange">
                        <ImageView style="@style/HomeIcon" android:src="@drawable/ic_link" />
                    </FrameLayout>
                    <LinearLayout style="@style/HomeCardText">
                        <TextView style="@style/HomeCardTitle" android:text="@string/home_new_analysis" />
                        <TextView style="@style/HomeCardSub"
                            android:text="Analyse automatique d'un lien" />
                    </LinearLayout>
                    <ImageView style="@style/HomeChevron" android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Simulation avant dépôt -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnSimulation"
                style="@style/HomeCard">
                <LinearLayout style="@style/HomeCardRow">
                    <FrameLayout style="@style/HomeIconWrap"
                        android:backgroundTint="@color/brand_brown">
                        <ImageView style="@style/HomeIcon" android:src="@drawable/ic_trending" />
                    </FrameLayout>
                    <LinearLayout style="@style/HomeCardText">
                        <TextView style="@style/HomeCardTitle" android:text="@string/home_simulation" />
                        <TextView style="@style/HomeCardSub"
                            android:text="Estimer votre position avant de déposer" />
                    </LinearLayout>
                    <ImageView style="@style/HomeChevron" android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Statistiques par catégorie -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnCompanies"
                style="@style/HomeCard">
                <LinearLayout style="@style/HomeCardRow">
                    <FrameLayout style="@style/HomeIconWrap"
                        android:backgroundTint="@color/brand_slate">
                        <ImageView style="@style/HomeIcon" android:src="@drawable/ic_trending" />
                    </FrameLayout>
                    <LinearLayout style="@style/HomeCardText">
                        <TextView style="@style/HomeCardTitle" android:text="@string/home_companies" />
                        <TextView style="@style/HomeCardSub"
                            android:text="Catégorie → domaine → sociétés" />
                    </LinearLayout>
                    <ImageView style="@style/HomeChevron" android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Statistiques par société -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnSociety"
                style="@style/HomeCard">
                <LinearLayout style="@style/HomeCardRow">
                    <FrameLayout style="@style/HomeIconWrap"
                        android:backgroundTint="@color/brand_orange_dark">
                        <ImageView style="@style/HomeIcon" android:src="@drawable/ic_clients" />
                    </FrameLayout>
                    <LinearLayout style="@style/HomeCardText">
                        <TextView style="@style/HomeCardTitle" android:text="@string/home_society" />
                        <TextView style="@style/HomeCardSub"
                            android:text="% de chaque société par domaine" />
                    </LinearLayout>
                    <ImageView style="@style/HomeChevron" android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Statistiques avancées -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAdvanced"
                style="@style/HomeCard">
                <LinearLayout style="@style/HomeCardRow">
                    <FrameLayout style="@style/HomeIconWrap"
                        android:backgroundTint="@color/brand_orange">
                        <ImageView style="@style/HomeIcon" android:src="@drawable/ic_trending" />
                    </FrameLayout>
                    <LinearLayout style="@style/HomeCardText">
                        <TextView style="@style/HomeCardTitle" android:text="@string/home_advanced" />
                        <TextView style="@style/HomeCardSub"
                            android:text="Vue d'ensemble par catégorie et domaine" />
                    </LinearLayout>
                    <ImageView style="@style/HomeChevron" android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Historique des analyses -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnHistory"
                style="@style/HomeCard">
                <LinearLayout style="@style/HomeCardRow">
                    <FrameLayout style="@style/HomeIconWrap"
                        android:backgroundTint="@color/brand_brown">
                        <ImageView style="@style/HomeIcon" android:src="@drawable/ic_calendar" />
                    </FrameLayout>
                    <LinearLayout style="@style/HomeCardText">
                        <TextView style="@style/HomeCardTitle" android:text="@string/home_history" />
                        <TextView style="@style/HomeCardSub"
                            android:text="Toutes vos analyses enregistrées" />
                    </LinearLayout>
                    <ImageView style="@style/HomeChevron" android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/disclaimer"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="italic" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
