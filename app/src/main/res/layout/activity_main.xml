<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- En-tête -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="56dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/on_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/slogan"
                android:textColor="@color/on_primary_dim"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManual"
                style="@style/PrimaryButton"
                app:icon="@drawable/ic_invoice"
                app:iconGravity="textStart"
                app:iconTint="@color/on_primary"
                android:text="@string/home_manual" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUrl"
                style="@style/OutlineButton"
                android:layout_marginTop="14dp"
                app:icon="@drawable/ic_link"
                app:iconGravity="textStart"
                android:text="@string/home_new_analysis" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimulation"
                style="@style/OutlineButton"
                android:layout_marginTop="14dp"
                app:icon="@drawable/ic_trending"
                app:iconGravity="textStart"
                android:text="@string/home_simulation" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistory"
                style="@style/OutlineButton"
                android:layout_marginTop="14dp"
                app:icon="@drawable/ic_calendar"
                app:iconGravity="textStart"
                android:text="@string/home_history" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbout"
                style="@style/OutlineButton"
                android:layout_marginTop="14dp"
                app:icon="@drawable/ic_info"
                app:iconGravity="textStart"
                android:text="@string/home_about" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/disclaimer"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="italic" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
