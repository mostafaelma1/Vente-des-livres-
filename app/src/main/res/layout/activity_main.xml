<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Arrière-plan plein écran (logo + arc orange intégrés à l'image) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="fitXY"
        android:src="@drawable/bg_app" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="150dp"
            android:paddingBottom="18dp">

            <!-- Bannière Premium -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnPremium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="26dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_premium_gradient"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_star"
                        android:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_premium_title"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.95"
                            android:text="@string/home_premium_sub"
                            android:textColor="@color/white"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_white"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="Bientôt"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Que voulez-vous faire ?"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_title_underline" />

            <!-- Nouvelle analyse -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnUrl"
                style="@style/HomeCard">
                <LinearLayout style="@style/HomeCardRow">
                    <FrameLayout style="@style/HomeIconWrap"
                        android:background="@drawable/circle_orange">
                        <ImageView style="@style/HomeIcon" android:src="@drawable/ic_link" />
                    </FrameLayout>
                    <LinearLayout style="@style/HomeCardText">
                        <TextView style="@style/HomeCardTitle" android:text="@string/home_new_analysis" />
                        <TextView style="@style/HomeCardSub"
                            android:text="Analyse automatique d'un lien" />
                    </LinearLayout>
                    <ImageView style="@style/HomeChevron" android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Simulation avant dépôt -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnSimulation"
                style="@style/HomeCard">
                <LinearLayout style="@style/HomeCardRow">
                    <FrameLayout style="@style/HomeIconWrap"
                        android:background="@drawable/circle_brown">
                        <ImageView style="@style/HomeIcon" android:src="@drawable/ic_trending" />
                    </FrameLayout>
                    <LinearLayout style="@style/HomeCardText">
                        <TextView style="@style/HomeCardTitle" android:text="@string/home_simulation" />
                        <TextView style="@style/HomeCardSub"
                            android:text="Estimer votre position avant de déposer" />
                    </LinearLayout>
                    <ImageView style="@style/HomeChevron" android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Statistiques par catégorie -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnCompanies"
                style="@style/HomeCard">
                <LinearLayout style="@style/HomeCardRow">
                    <FrameLayout style="@style/HomeIconWrap"
                        android:background="@drawable/circle_dark">
                        <ImageView style="@style/HomeIcon" android:src="@drawable/ic_clients" />
                    </FrameLayout>
                    <LinearLayout style="@style/HomeCardText">
                        <TextView style="@style/HomeCardTitle" android:text="@string/home_companies" />
                        <TextView style="@style/HomeCardSub"
                            android:text="Catégorie → domaine → sociétés" />
                    </LinearLayout>
                    <ImageView style="@style/HomeChevron" android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Statistiques par société -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnSociety"
                style="@style/HomeCard">
                <LinearLayout style="@style/HomeCardRow">
                    <FrameLayout style="@style/HomeIconWrap"
                        android:background="@drawable/circle_deep">
                        <ImageView style="@style/HomeIcon" android:src="@drawable/ic_clients" />
                    </FrameLayout>
                    <LinearLayout style="@style/HomeCardText">
                        <TextView style="@style/HomeCardTitle" android:text="@string/home_society" />
                        <TextView style="@style/HomeCardSub"
                            android:text="% de chaque société par domaine" />
                    </LinearLayout>
                    <ImageView style="@style/HomeChevron" android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Historique des analyses -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnHistory"
                style="@style/HomeCard">
                <LinearLayout style="@style/HomeCardRow">
                    <FrameLayout style="@style/HomeIconWrap"
                        android:background="@drawable/circle_brown">
                        <ImageView style="@style/HomeIcon" android:src="@drawable/ic_calendar" />
                    </FrameLayout>
                    <LinearLayout style="@style/HomeCardText">
                        <TextView style="@style/HomeCardTitle" android:text="@string/home_history" />
                        <TextView style="@style/HomeCardSub"
                            android:text="Toutes vos analyses enregistrées" />
                    </LinearLayout>
                    <ImageView style="@style/HomeChevron" android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contact -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnContact"
                style="@style/HomeCard">
                <LinearLayout style="@style/HomeCardRow">
                    <FrameLayout style="@style/HomeIconWrap"
                        android:background="@drawable/circle_amber">
                        <ImageView style="@style/HomeIcon" android:src="@drawable/ic_info" />
                    </FrameLayout>
                    <LinearLayout style="@style/HomeCardText">
                        <TextView style="@style/HomeCardTitle" android:text="@string/home_contact" />
                        <TextView style="@style/HomeCardSub"
                            android:text="Nous écrire / nous joindre" />
                    </LinearLayout>
                    <ImageView style="@style/HomeChevron" android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_info"
                    android:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/disclaimer"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Logo fixe en haut (superposé, ne défile pas) -->
    <ImageView
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="18dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:src="@drawable/logo_bmarche_t" />
</FrameLayout>
