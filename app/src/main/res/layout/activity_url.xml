<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- WebView en arrière-plan : toujours recouverte par les panneaux opaques
         (l'utilisateur ne la voit jamais), mais rendue pour le scraping local. -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ÉCRAN 1 : saisie de l'URL -->
    <LinearLayout
        android:id="@+id/setupPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Nouvelle analyse"
            app:titleTextColor="@color/on_primary"
            app:navigationIconTint="@color/on_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analyse locale automatique. Aucun serveur. Collez le lien et lancez : l'app s'occupe de tout."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="URL marchespublics.gov.ma">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoad"
                style="@style/PrimaryButton"
                android:layout_marginTop="14dp"
                android:text="Analyser" />
        </LinearLayout>
    </LinearLayout>

    <!-- ÉCRAN 2 : animation pendant l'analyse (cache la WebView) -->
    <LinearLayout
        android:id="@+id/loadingPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivPulse"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_bmarche" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:indeterminate="true"
            app:indicatorColor="@color/brand_orange"
            app:trackCornerRadius="4dp"
            app:trackThickness="5dp" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Analyse en cours…"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Actions de secours (affichées seulement si l'auto échoue) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            style="@style/PrimaryButton"
            android:layout_marginTop="22dp"
            android:visibility="gone"
            android:text="Continuer en mode manuel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnColumns"
            style="@style/OutlineButton"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:text="Choisir les colonnes" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="@style/OutlineButton"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:text="Réessayer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExport"
            style="@style/OutlineButton"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:text="Exporter les données (debug)" />
    </LinearLayout>
</FrameLayout>
