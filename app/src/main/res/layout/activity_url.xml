<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Analyse locale par URL"
        app:titleTextColor="@color/on_primary"
        app:navigationIconTint="@color/on_primary" />

    <!-- Saisie de l'URL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analyse locale disponible. Aucun serveur nécessaire. Collez le lien et chargez la page : l'analyse se lance automatiquement."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="URL marchespublics.gov.ma">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoad"
            style="@style/PrimaryButton"
            android:layout_marginTop="8dp"
            android:text="Charger la page" />

        <TextView
            android:id="@+id/tvRefOrg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Navigateur intégré (WebView) -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!-- Panneau d'action -->
    <LinearLayout
        android:id="@+id/actionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExtract"
            style="@style/PrimaryButton"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="Extraire les données de la page" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            style="@style/PrimaryButton"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="Vérifier et calculer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnColumns"
            style="@style/OutlineButton"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="Choisir les colonnes manuellement" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExport"
            style="@style/OutlineButton"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="Exporter les données brutes (debug)" />
    </LinearLayout>
</LinearLayout>
