<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Mode manuel"
        app:titleTextColor="@color/on_primary"
        app:navigationIconTint="@color/on_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView style="@style/CardSection">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/SectionTitle" android:text="Informations de l'appel d'offres" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:hint="@string/f_reference">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etReference" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:hint="@string/f_objet">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etObjet" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:hint="@string/f_maitre">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMaitre" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:hint="@string/f_type">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/acType" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:hint="@string/f_lieu">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLieu" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:hint="@string/f_estimation">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEstimation" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="10dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:hint="@string/f_lot_num">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etLotNum" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:text="1" android:inputType="text" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp" android:layout_weight="2"
                            android:layout_marginStart="10dp"
                            android:layout_height="wrap_content" android:hint="@string/f_lot_desig">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etLotDesig" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:inputType="textCapSentences" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/CardSection" android:layout_marginTop="14dp">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/SectionTitle" android:text="Concurrents" />

                    <LinearLayout
                        android:id="@+id/competitorsContainer"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddCompetitor"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="@string/add_competitor"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculate"
                style="@style/PrimaryButton"
                android:layout_marginTop="18dp"
                android:text="@string/calculate" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
